# Excludes paths from Claude Code indexing and search (security-baseline.mdc §3).
# Seeded by scripts/install.sh when the target repo has no .claudeignore yet.

# Secrets and local config (never index)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
credentials.json
*credentials*.json
secrets.yaml
secrets.yml
**/application-local.yml
**/application-local.yaml
**/application-secrets.yml
**/application-secrets.yaml

# Dependencies and build output (noise + size)
node_modules/
target/
.gradle/
build/
# Delivery evidence under docs/build/ stays indexable for agents (Build evidence contract)
!docs/build/
!docs/build/**
# Verify reports stay indexable for agents (Verify evidence contract)
!docs/verify/
!docs/verify/**
out/
dist/
.svelte-kit/
.output/
.next/
.nuxt/
.vercel/
coverage/
**/site/jacoco/

# VCS and package caches
.git/
.npm/
.yarn/
.pnpm-store/

# Logs and dumps
*.log
logs/
*.hprof

# Security / quality scan artifacts (may summarize CVEs with paths)
dependency-check-report.html
.scannerwork/
.sonar/

# OS junk
.DS_Store
Thumbs.db
