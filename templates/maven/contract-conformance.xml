<!--
  OpenAPI contract-conformance snippet — paste into <build><plugins> of pom.xml,
  next to maven/quality-plugins.xml. Generates the runtime OpenAPI from the running
  app, then diffs it against the approved contract; an incompatible change fails
  `mvn -B clean verify` (workflow-orchestration.mdc Build gate).
  Adjust paths, versions, and the apiDocsUrl port per service. N/A with a recorded
  reason when the service generates no spec. Keep the approved contract under
  version control (e.g. openapi/api-v1.yaml).

  The approved contract is read from the property kit.openapi.catalog. Add to the pom:
    one service in the repo:
      <properties><kit.openapi.catalog>${project.basedir}/openapi/api-v1.yaml</kit.openapi.catalog></properties>
    several services (Profile Layout lists Service roots), each with its own catalog
    openapi/<service>-v1.yaml at the repo root, where <service> is the last segment of the
    service root:
      <properties><kit.openapi.catalog>${project.basedir}/../../openapi/order-v1.yaml</kit.openapi.catalog></properties>
-->

<plugin>
  <groupId>org.springdoc</groupId>
  <artifactId>springdoc-openapi-maven-plugin</artifactId>
  <version>1.5</version>
  <configuration>
    <apiDocsUrl>http://localhost:8080/v3/api-docs</apiDocsUrl>
    <outputFileName>openapi.json</outputFileName>
    <outputDir>${project.build.directory}</outputDir>
  </configuration>
  <executions>
    <execution>
      <id>generate-openapi</id>
      <phase>integration-test</phase>
      <goals><goal>generate</goal></goals>
    </execution>
  </executions>
</plugin>

<plugin>
  <groupId>org.openapitools</groupId>
  <artifactId>openapi-diff-maven-plugin</artifactId>
  <version>2.1.0</version>
  <configuration>
    <oldSpec>${kit.openapi.catalog}</oldSpec>
    <newSpec>${project.build.directory}/openapi.json</newSpec>
    <failOnIncompatible>true</failOnIncompatible>
    <failOnChanged>false</failOnChanged>
  </configuration>
  <executions>
    <execution>
      <id>diff-against-approved</id>
      <phase>verify</phase>
      <goals><goal>diff</goal></goals>
    </execution>
  </executions>
</plugin>
