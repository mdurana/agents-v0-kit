#!/bin/sh
# Optional pre-push hook. It is not installed into .git/hooks automatically.
#
#   cp hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# When the branch name's last segment matches docs/requirements/<feature>.md, runs
# scripts/check-delivery-gate-local.sh and rejects the push when that gate fails.
# Other branches are pushed unchanged.
set -eu

root="$(git rev-parse --show-toplevel)"
cd "$root"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  case "$local_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  branch="${local_ref#refs/heads/}"
  feature="${branch##*/}"
  artifact="docs/requirements/${feature}.md"
  if [ ! -f "$artifact" ]; then
    printf 'pre-push: no %s — feature gate skipped\n' "$artifact" >&2
    continue
  fi
  if [ ! -x scripts/check-delivery-gate-local.sh ] && [ ! -f scripts/check-delivery-gate-local.sh ]; then
    printf 'pre-push: scripts/check-delivery-gate-local.sh is missing\n' >&2
    exit 1
  fi
  printf 'pre-push: local delivery gate for %s\n' "$feature" >&2
  sh scripts/check-delivery-gate-local.sh "$feature" --base origin/HEAD
done

exit 0
