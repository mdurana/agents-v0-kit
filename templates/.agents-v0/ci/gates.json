{
  "_comment": [
    "Phase gate manifest: the one place that says which document checks gate which phase.",
    "Read by .agents-v0/ci/gate.sh (commands, the after-edit Cursor hook, and the pre-commit git hook).",
    "Paths in 'run' are relative to .agents-v0/. Placeholders: {artifact} (repo-relative path of the",
    "approval file) and {feature} (its basename without .md). 'ifExists' skips the entry when that path",
    "(after placeholder expansion) does not exist.",
    "'draft' runs before the person approves (advisory in after-edit). 'approved' runs when the staged",
    "approval file adds an Approved row for the phase (blocking in pre-commit).",
    "'sealedEdits': true also runs 'approved' when an already-approved file of that phase is edited.",
    "Build, Verify, and Release evidence (check-evidence.sh, check-gate-metrics.sh) needs the report to",
    "be committed first, so it is enforced by pre-push (check-delivery-gate-local.sh) and CI, not here."
  ],
  "version": 1,
  "phases": {
    "onboard": {
      "approvalFile": [
        "docs/agents-v0/onboarding/report.md"
      ],
      "draft": [
        {
          "run": [
            "scripts/check-onboarding-docs.sh"
          ]
        }
      ],
      "approved": [
        {
          "run": [
            "scripts/check-onboarding-docs.sh"
          ]
        },
        {
          "run": [
            "ci/check-feature-state.sh",
            "{artifact}"
          ]
        }
      ]
    },
    "roadmap": {
      "approvalFile": [
        "docs/agents-v0/roadmap/*.md"
      ],
      "sealedEdits": true,
      "draft": [
        {
          "run": [
            "ci/check-roadmap.sh",
            "{artifact}"
          ]
        }
      ],
      "approved": [
        {
          "run": [
            "ci/check-roadmap.sh",
            "--approved",
            "{artifact}"
          ]
        }
      ]
    },
    "architecture": {
      "approvalFile": [
        "docs/agents-v0/architecture.md"
      ],
      "sealedEdits": true,
      "draft": [
        {
          "run": [
            "ci/check-architecture-pack.sh",
            "{artifact}"
          ]
        },
        {
          "run": [
            "ci/check-adr.sh"
          ]
        }
      ],
      "approved": [
        {
          "run": [
            "ci/check-adr.sh"
          ]
        },
        {
          "run": [
            "ci/check-architecture-pack.sh",
            "--approved",
            "{artifact}"
          ]
        },
        {
          "run": [
            "ci/check-approvals.sh",
            "{artifact}",
            "architecture"
          ]
        }
      ]
    },
    "plan": {
      "approvalFile": [
        "docs/agents-v0/milestones/*.md"
      ],
      "draft": [
        {
          "run": [
            "ci/check-milestone.sh",
            "{artifact}",
            "plan"
          ]
        }
      ],
      "approved": [
        {
          "run": [
            "ci/check-milestone.sh",
            "{artifact}",
            "plan"
          ]
        },
        {
          "run": [
            "ci/check-approvals.sh",
            "{artifact}",
            "plan"
          ]
        }
      ]
    },
    "intake": {
      "approvalFile": [
        "docs/agents-v0/requirements/*.md"
      ],
      "draft": [
        {
          "run": [
            "ci/check-intake.sh",
            "{artifact}"
          ]
        }
      ],
      "approved": [
        {
          "run": [
            "ci/check-intake.sh",
            "{artifact}"
          ]
        },
        {
          "run": [
            "ci/check-approvals.sh",
            "{artifact}",
            "intake"
          ]
        },
        {
          "run": [
            "ci/check-feature-state.sh",
            "{artifact}"
          ]
        }
      ]
    },
    "design": {
      "approvalFile": [
        "docs/agents-v0/requirements/*.md"
      ],
      "draft": [
        {
          "run": [
            "ci/check-design.sh",
            "{feature}"
          ],
          "ifExists": "docs/agents-v0/design/{feature}/design.md"
        },
        {
          "run": [
            "ci/check-adr.sh"
          ]
        },
        {
          "run": [
            "ci/check-openapi.sh",
            "lint",
            "docs/agents-v0/design/{feature}/openapi.yaml"
          ],
          "ifExists": "docs/agents-v0/design/{feature}/openapi.yaml"
        },
        {
          "run": [
            "ci/check-openapi.sh",
            "compat",
            "docs/agents-v0/design/{feature}/openapi.yaml",
            "openapi/api-v1.yaml"
          ],
          "ifExists": [
            "docs/agents-v0/design/{feature}/openapi.yaml",
            "openapi/api-v1.yaml"
          ]
        },
        {
          "run": [
            "ci/check-asyncapi.sh",
            "lint",
            "docs/agents-v0/design/{feature}/asyncapi.yaml"
          ],
          "ifExists": "docs/agents-v0/design/{feature}/asyncapi.yaml"
        },
        {
          "run": [
            "ci/check-ux-spec.sh",
            "{feature}"
          ],
          "ifExists": "docs/agents-v0/design/{feature}/ux-spec.md"
        }
      ],
      "approved": [
        {
          "run": [
            "ci/check-design.sh",
            "{feature}"
          ]
        },
        {
          "run": [
            "ci/check-adr.sh"
          ]
        },
        {
          "run": [
            "ci/check-openapi.sh",
            "lint",
            "docs/agents-v0/design/{feature}/openapi.yaml"
          ],
          "ifExists": "docs/agents-v0/design/{feature}/openapi.yaml"
        },
        {
          "run": [
            "ci/check-openapi.sh",
            "compat",
            "docs/agents-v0/design/{feature}/openapi.yaml",
            "openapi/api-v1.yaml"
          ],
          "ifExists": [
            "docs/agents-v0/design/{feature}/openapi.yaml",
            "openapi/api-v1.yaml"
          ]
        },
        {
          "run": [
            "ci/check-asyncapi.sh",
            "lint",
            "docs/agents-v0/design/{feature}/asyncapi.yaml"
          ],
          "ifExists": "docs/agents-v0/design/{feature}/asyncapi.yaml"
        },
        {
          "run": [
            "ci/check-ux-spec.sh",
            "{feature}"
          ],
          "ifExists": "docs/agents-v0/design/{feature}/ux-spec.md"
        },
        {
          "run": [
            "ci/check-approvals.sh",
            "{artifact}",
            "design"
          ]
        },
        {
          "run": [
            "ci/check-feature-state.sh",
            "{artifact}"
          ]
        }
      ]
    },
    "build": {
      "approvalFile": [
        "docs/agents-v0/requirements/*.md"
      ],
      "draft": [],
      "approved": [
        {
          "run": [
            "ci/check-feature-state.sh",
            "{artifact}"
          ]
        }
      ]
    },
    "verify": {
      "approvalFile": [
        "docs/agents-v0/requirements/*.md"
      ],
      "draft": [],
      "approved": [
        {
          "run": [
            "ci/check-feature-state.sh",
            "{artifact}"
          ]
        }
      ]
    },
    "release": {
      "approvalFile": [
        "docs/agents-v0/requirements/*.md"
      ],
      "draft": [],
      "approved": [
        {
          "run": [
            "ci/check-feature-state.sh",
            "{artifact}"
          ]
        }
      ]
    }
  }
}
