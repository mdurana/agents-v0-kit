#!/bin/sh
# Pre-push hook. install.sh --git-hooks activates it (core.hooksPath=.agents-v0/hooks).
# When the branch name's last segment matches docs/agents-v0/requirements/<feature>.state.json
# or docs/agents-v0/maintain/<id>/state.json, verifies that the state has verifyPassed=true
# or lastApprovedPhase in (verify, release).
# Design: D1 (onboard redo): first, every commit the push sends is secret-scanned through
# .agents-v0/scripts/guard-common.sh scan-push (secret_scan.py --commits); a hit, or a scan that cannot run, refuses
# the push. A missing guard-common.sh refuses too (fail closed): reinstall with install.sh --update.
set -eu

root="$(git rev-parse --show-toplevel)"
cd "$root"

# git gives the refs on stdin; read them once, the secret scan and the state check below both use them.
refs="$(cat)"
if [ ! -f ".agents-v0/scripts/guard-common.sh" ]; then
  printf 'pre-push: .agents-v0/scripts/guard-common.sh is missing, so the pushed commits cannot be secret-scanned; push refused (run install.sh --update).\n' >&2
  exit 1
fi
if ! printf '%s\n' "$refs" | sh .agents-v0/scripts/guard-common.sh scan-push "${1:-}"; then
  printf 'pre-push: secret scan refused the push.\n' >&2
  exit 1
fi

if [ -f ".agents-v0/scripts/check-lessons.sh" ]; then
  sh .agents-v0/scripts/check-lessons.sh
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  if [ "${local_sha:-}" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  case "$local_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  branch="${local_ref#refs/heads/}"
  case "$branch" in
    feature/*|maintain/*)
      if [ -f ".agents-v0/scripts/check-lessons.sh" ]; then
        base_ref="main"
        if [ -f ".agents-v0/scripts/resolve-integration-branch.sh" ]; then
          base_ref="$(sh .agents-v0/scripts/resolve-integration-branch.sh 2>/dev/null || printf 'main')"
        fi
        if [ "$base_ref" != "HEAD" ] && git rev-parse --verify -q "${base_ref}^{commit}" >/dev/null 2>&1; then
          sh .agents-v0/scripts/check-lessons.sh --unchanged-since "$base_ref" --tip "$local_sha"
        fi
      fi
      ;;
  esac
  feature="${branch##*/}"
  state_file="docs/agents-v0/requirements/${feature}.state.json"
  if ! git cat-file -e "$local_sha:$state_file" 2>/dev/null && [ ! -f "$state_file" ]; then
    state_file="docs/agents-v0/maintain/${feature}/state.json"
  fi
  if ! git cat-file -e "$local_sha:$state_file" 2>/dev/null && [ ! -f "$state_file" ]; then
    continue
  fi
  python3 - "$local_sha" "$state_file" <<'PY'
import json
import subprocess
import sys

sha, path = sys.argv[1], sys.argv[2]
try:
    proc = subprocess.run(["git", "show", f"{sha}:{path}"], capture_output=True, text=True, check=False)
    if proc.returncode == 0:
        data = json.loads(proc.stdout)
    else:
        data = json.load(open(path, encoding="utf-8"))
except Exception as exc:
    print(f"pre-push: invalid JSON in {path}: {exc}", file=sys.stderr)
    sys.exit(1)

last_app = (data.get("lastApprovedPhase") or "").lower()
approved = [p.lower() for p in (data.get("approvedPhases") or [])]
verify_passed = bool(data.get("verifyPassed"))

if not (verify_passed or last_app in ("verify", "release") or "verify" in approved or "release" in approved):
    print(
        f"pre-push: {path} has not passed /v0-verify yet (lastApprovedPhase={last_app or '-'}, verifyPassed={verify_passed}).",
        file=sys.stderr,
    )
    sys.exit(1)
PY
done <<EOF_REFS
$refs
EOF_REFS

exit 0
