#!/bin/sh
# pre-commit — block a commit whose staged delivery artifacts fail their phase gate.
#
# Installed by: install.sh --git-hooks (sets core.hooksPath=.agents-v0/hooks).
# Runs only when the commit stages a delivery document; ordinary code commits are not slowed down.
# The gate list lives in .agents-v0/ci/gates.json and runs through .agents-v0/ci/gate.sh --staged:
# an Approved row that this commit adds or changes must pass that phase's checks, and an edit to an
# already-approved roadmap or architecture pack must still pass the approved checks.
set -eu

root="$(git rev-parse --show-toplevel)"
cd "$root"

git diff --cached --name-only --diff-filter=ACMR \
  | grep -Eq '^docs/agents-v0/(roadmap|milestones|requirements|onboarding)/[^/]+\.md$|^docs/agents-v0/architecture\.md$' \
  || exit 0

if [ ! -f .agents-v0/ci/gate.sh ]; then
  printf 'pre-commit: .agents-v0/ci/gate.sh is missing — run install.sh --update, or remove core.hooksPath\n' >&2
  exit 1
fi

exec sh .agents-v0/ci/gate.sh --staged
