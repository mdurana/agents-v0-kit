{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [".kilo/rules/**/*.md"],
  "permission": {
    "bash": {
      "*git push --force*": "deny",
      "*git push -f*": "deny",
      "*git push --force-with-lease*": "deny",
      "*git -c * push*force*": "deny",
      "*git reset --hard*": "deny",
      "*rm -rf*": "deny",
      "*rm -fr*": "deny",
      "*rm -r -f*": "deny",
      "*kubectl delete*": "deny",
      "*terraform apply*auto-approve*": "deny",
      "*cat .env*": "deny",
      "*cat *.env*": "deny",
      "printenv": "deny",
      "printenv *": "deny",
      "* printenv*": "deny",
      "env": "deny",
      "env *": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "* git commit*": "ask",
      "* git push*": "ask",
      "gh pr merge*": "deny",
      "* gh pr merge*": "deny",
      "glab mr merge*": "deny",
      "* glab mr merge*": "deny",
      "gh release create*": "ask",
      "git clean*": "ask",
      "* git clean*": "ask",
      "*docker push*": "ask",
      "*podman push*": "ask",
      "*npm publish*": "ask"
    }
  }
}
