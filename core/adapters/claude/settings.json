{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KIT_HOOK_FLAVOR=claude KIT_HOOKS=\"$CLAUDE_PROJECT_DIR\"/.claude/hooks sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "KIT_HOOK_FLAVOR=claude KIT_HOOKS=\"$CLAUDE_PROJECT_DIR\"/.claude/hooks sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-mcp.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "KIT_HOOK_FLAVOR=claude KIT_HOOKS=\"$CLAUDE_PROJECT_DIR\"/.claude/hooks sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-shell.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Delete",
        "hooks": [
          {
            "type": "command",
            "command": "KIT_HOOK_FLAVOR=claude KIT_HOOKS=\"$CLAUDE_PROJECT_DIR\"/.claude/hooks sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-edit.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "KIT_HOOK_FLAVOR=claude KIT_HOOKS=\"$CLAUDE_PROJECT_DIR\"/.claude/hooks sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KIT_HOOK_FLAVOR=claude KIT_HOOKS=\"$CLAUDE_PROJECT_DIR\"/.claude/hooks sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop.sh"
          }
        ]
      }
    ]
  }
}
