{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "KIT_HOOK_FLAVOR=cursor /bin/sh .cursor/hooks/session-start.sh",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "KIT_HOOK_FLAVOR=cursor /bin/sh .cursor/hooks/pre-shell.sh",
        "failClosed": true,
        "timeout": 30
      }
    ],
    "preToolUse": [
      {
        "matcher": "Edit|Write|Delete",
        "command": "KIT_HOOK_FLAVOR=cursor /bin/sh .cursor/hooks/pre-edit.sh",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "KIT_HOOK_FLAVOR=cursor /bin/sh .cursor/hooks/stop.sh",
        "timeout": 15
      }
    ]
  }
}
