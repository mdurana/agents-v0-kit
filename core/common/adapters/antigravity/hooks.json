{
  "version": 1,
  "agents-v0-delivery": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "KIT_HOOK_FLAVOR=antigravity sh -c '[ -f .agents/hooks/session-start.sh ] && sh .agents/hooks/session-start.sh || (cd .. && sh .agents/hooks/session-start.sh)'",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "KIT_HOOK_FLAVOR=antigravity sh -c '[ -f .agents/hooks/pre-shell.sh ] && sh .agents/hooks/pre-shell.sh || (cd .. && sh .agents/hooks/pre-shell.sh)'",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "KIT_HOOK_FLAVOR=antigravity sh -c '[ -f .agents/hooks/pre-edit.sh ] && sh .agents/hooks/pre-edit.sh || (cd .. && sh .agents/hooks/pre-edit.sh)'",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "KIT_HOOK_FLAVOR=antigravity sh -c '[ -f .agents/hooks/stop.sh ] && sh .agents/hooks/stop.sh || (cd .. && sh .agents/hooks/stop.sh)'",
        "timeout": 15
      }
    ]
  }
}
