{
  "default": "ask",
  "servers": {
    "github": {
      "block": ["merge_*", "delete_*"],
      "allow": ["list_*", "get_*", "search_*"],
      "ask": ["*"],
      "default": "ask"
    },
    "gitlab": {
      "block": ["merge_*", "delete_*", "accept_*"],
      "allow": ["list_*", "get_*", "search_*", "api_get_*", "api_list_*", "api_search_*"],
      "ask": ["*"],
      "default": "ask"
    }
  }
}
