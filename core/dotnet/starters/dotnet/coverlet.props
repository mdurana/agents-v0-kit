<!-- Copy into the test project or Directory.Build.props.
     dotnet test then writes TestResults/*.trx and coverage.cobertura.xml. -->
<Project>
  <PropertyGroup>
    <CollectCoverage Condition="'$(CollectCoverage)' == ''">true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>../coverage.cobertura.xml</CoverletOutput>
  </PropertyGroup>
</Project>
