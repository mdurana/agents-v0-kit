<!--
  OWASP Dependency-Check for CI only — merge into a Maven profile (e.g. ci-security)
  and run: ./mvnw -B clean verify -Pci-security
  Keep fast local verify without this profile (workflow-orchestration.mdc / project-profile.md).
  The suppression file is read from kit.maven.dir; define that property in the pom as
  described in maven/quality-plugins.xml.
-->
<profile>
  <id>ci-security</id>
  <build>
    <plugins>
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>10.0.4</version>
        <configuration>
          <failBuildOnCVSS>7</failBuildOnCVSS>
          <!-- Sonatype OSS Index rejects anonymous calls with HTTP 401 and fails the goal. NVD is the CVE source. -->
          <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
          <!-- JSON is read by ci/check-gate-metrics.sh (target/dependency-check-report.json). -->
          <formats>
            <format>HTML</format>
            <format>JSON</format>
          </formats>
          <suppressionFiles>
            <suppressionFile>${kit.maven.dir}/dependency-check-suppressions.xml</suppressionFile>
          </suppressionFiles>
          <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
          <!-- Optional NVD mirror via -DnvdDatafeedUrl=... or env NVD_DATAFEED_URL; NVD_API_KEY env for API key. -->
        </configuration>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</profile>
